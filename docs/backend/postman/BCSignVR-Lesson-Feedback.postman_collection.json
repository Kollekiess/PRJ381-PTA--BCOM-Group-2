{
  "info": {
    "_postman_id": "713f190e-30d2-4b75-bf60-9b7e75d1a721",
    "name": "BCSignVR - Lesson and Feedback API",
    "description": "Set a confirmed test account, login, list lessons, then submit and reload feedback. Clear attemptId and attemptedAt for a new attempt; keep them for a retry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "lessonId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "attemptedAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register test account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"authToken\", data.session.access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
        {
          "name": "List lessons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lessons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lessons"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lessons load\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 && !pm.collectionVariables.get(\"lessonId\")) {",
                  "  const lessons = pm.response.json().lessons;",
                  "  if (lessons.length) pm.collectionVariables.set(\"lessonId\", lessons[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get lesson",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lessons/{{lessonId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lessons",
                "{{lessonId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get lesson progress",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lessons/{{lessonId}}/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lessons",
                "{{lessonId}}",
                "progress"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit gesture result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feedback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "feedback"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"{{attemptId}}\",\n  \"lessonId\": \"{{lessonId}}\",\n  \"target\": \"A\",\n  \"predicted\": \"A\",\n  \"confidence\": 0.9,\n  \"target_score\": 0.9,\n  \"correct\": true,\n  \"message\": \"Correct!\",\n  \"hint\": \"\",\n  \"attemptedAt\": \"{{attemptedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"attemptId\")) pm.collectionVariables.set(\"attemptId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "if (!pm.collectionVariables.get(\"attemptedAt\")) pm.collectionVariables.set(\"attemptedAt\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Attempt saves or retries\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if ([200, 201].includes(pm.response.code)) pm.test(\"Progress returned\", () => pm.expect(pm.response.json().updatedProgress.lessonId).to.eql(pm.collectionVariables.get(\"lessonId\")));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
