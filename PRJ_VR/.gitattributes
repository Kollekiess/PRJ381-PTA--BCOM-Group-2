# Unity YAML merge tool settings
*.cs diff=csharp text
*.cginc text
*.shader text
*.unity text merge=unityyamlmerge
*.prefab text merge=unityyamlmerge
*.mat text merge=unityyamlmerge

# Git LFS for Large Binary Assets
