--- !u!114 &590751530
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 590751528}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ad94e6b932f8a44ca5903946a586ab7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChalkboardLesson
  idleContainer: {fileID: 1156683596}
  lessonContainer: {fileID: 1932198315}
  headerTmp: {fileID: 1073713887}
  col1TitleTmp: {fileID: 562220537}
  col1DescTmp: {fileID: 908952289}
  col1ImageRend: {fileID: 1102097680}
  col2TitleTmp: {fileID: 888079722}
  col2DescTmp: {fileID: 1191762088}
  col2ImageRend: {fileID: 892782449}
  col3TitleTmp: {fileID: 265114949}
  col3DescTmp: {fileID: 64571193}
  col3ImageRend: {fileID: 1440388848}
  lessons:
  - lessonTitle: American Sign Language (ASL)
    lessonSubtitle: Everyday Greetings & Politeness
    shortSummary: 'Essential greetings: <b>HELLO</b>, <b>THANK YOU</b>, and <b>PLEASE</b>.'
    sign1:
      title: 1. HELLO
      description: 'Hand at temple

        extending outward

        (friendly
        salute)'
      imageTexture: {fileID: 2800000, guid: 76d2a261cb63baa4d99bffd2c76e0478, type: 3}
    sign2:
      title: 2. THANK YOU
      description: 'Fingertips on chin,

        move palm forward

        towards
        person'
      imageTexture: {fileID: 2800000, guid: ffa47d21928a26e46855a369492a69d7, type: 3}
    sign3:
      title: 3. PLEASE
      description: 'Flat open palm on

        chest in a clockwise

        circle
        gesture'
      imageTexture: {fileID: 2800000, guid: e7bacae52d71aa9419b46a1a60786883, type: 3}
  - lessonTitle: Basic Responses
    lessonSubtitle: Everyday Affirmations & Assistance
    shortSummary: 'Core responses: <b>YES</b>, <b>NO</b>, and asking for <b>HELP</b>.'
    sign1:
      title: 1. YES
      description: 'S-hand fist nods

        downward repeatedly

        from the
        wrist'
      imageTexture: {fileID: 2800000, guid: 9e1665ff66306714388ff9af319a3bb8, type: 3}
    sign2:
      title: 2. NO
      description: 'Index & middle fingers

        snap closed against

        the
        thumb'
      imageTexture: {fileID: 2800000, guid: ebee4d64ddf2fd84691d6fb82affedfa, type: 3}
    sign3:
      title: 3. HELP
      description: 'Closed fist on flat

        palm, both lifted up

        together'
      imageTexture: {fileID: 2800000, guid: e81eb99be3dac464d903ac48cd127fce, type: 3}
  - lessonTitle: Family & People
    lessonSubtitle: Connecting with Loved Ones
    shortSummary: 'Key relationships: <b>MOTHER</b>, <b>FATHER</b>, and <b>FRIEND</b>.'
    sign1:
      title: 1. MOTHER
      description: 'Open 5-hand with thumb

        tapping chin twice

        gently'
      imageTexture: {fileID: 2800000, guid: eb884dd7433c85040a2897d9879cb8f8, type: 3}
    sign2:
      title: 2. FATHER
      description: 'Open 5-hand with thumb

        tapping forehead twice

        gently'
      imageTexture: {fileID: 2800000, guid: 3488fe4004398d641afc2f87383a79e0, type: 3}
    sign3:
      title: 3. FRIEND
      description: 'Index fingers hook

        together, reverse and

        hook
        again'
      imageTexture: {fileID: 2800000, guid: 470a0efd86125664ca7ca1f0fcf365c9, type: 3}
  - lessonTitle: Everyday Needs
    lessonSubtitle: Food, Drinks & Requests
    shortSummary: 'Daily essentials: <b>EAT / FOOD</b>, <b>WATER</b>, and <b>MORE</b>.'
    sign1:
      title: 1. EAT / FOOD
      description: 'Flat O-hand fingertips

        tap lips twice

        in eating
        motion'
      imageTexture: {fileID: 2800000, guid: c778e2c8af1ac584bb9693d1c32d795f, type: 3}
    sign2:
      title: 2. WATER
      description: 'W-handshape index

        finger taps lower lip

        twice'
      imageTexture: {fileID: 2800000, guid: aac330672efa81840878842c2ae2f39a, type: 3}
    sign3:
      title: 3. MORE
      description: 'Both flat-O hands

        tap fingertips together

        repeatedly'
      imageTexture: {fileID: 2800000, guid: a91bec4e7f626b14ea3029e19d868ae7, type: 3}
  - lessonTitle: Feelings & Emotions
    lessonSubtitle: Expressing Emotional States
    shortSummary: 'Sharing feelings: <b>HAPPY</b>, <b>SAD</b>, and <b>LOVE</b>.'
    sign1:
      title: 1. HAPPY
      description: 'Open flat hands brush

        upward against chest

        in
        repeating circles'
      imageTexture: {fileID: 2800000, guid: bd0d0e3ca7d9d3745b14307684a4e0e6, type: 3}
    sign2:
      title: 2. SAD
      description: 'Open palms facing face

        draw slowly downward

        with
        solemn look'
      imageTexture: {fileID: 2800000, guid: 92cc96e73af28464682e0eec7d148f61, type: 3}
    sign3:
      title: 3. LOVE
      description: 'Both arms crossed

        hugging against chest

        with
        closed fists'
      imageTexture: {fileID: 2800000, guid: 2fce9d9f0515cba4facc47522b4528c7, type: 3}
  - lessonTitle: Core Questions
    lessonSubtitle: Inquiring & Asking Questions
    shortSummary: 'Key questions: <b>WHO</b>, <b>WHAT</b>, and <b>WHERE</b>.'
    sign1:
      title: 1. WHO
      description: 'Thumb on chin while

        index finger wiggles

        up
        and down'
      imageTexture: {fileID: 2800000, guid: 7703833b56dea634a9df002fbcd20cdf, type: 3}
    sign2:
      title: 2. WHAT
      description: 'Open palms facing up

        moving side-to-side in

        questioning
        sweep'
      imageTexture: {fileID: 2800000, guid: 1a4ab65c6bccbd34c83c7c16c0a8076b, type: 3}
    sign3:
      title: 3. WHERE
      description: 'Index finger pointing

        up, swaying left and

        right
        gently'
      imageTexture: {fileID: 2800000, guid: 4b582d78c6e8fa346941c90fab3153f2, type: 3}
  - lessonTitle: Time & Everyday Terms
    lessonSubtitle: Timeframes & Expressions
    shortSummary: 'Everyday terms: <b>TODAY</b>, <b>TOMORROW</b>, and <b>GOOD</b>.'
    sign1:
      title: 1. TODAY / NOW
      description: 'Both Y-hands drop

        downward twice in

        front of
        body'
      imageTexture: {fileID: 2800000, guid: b5a71163e0474dd4fbe8cf5367065b70, type: 3}
    sign2:
      title: 2. TOMORROW
      description: 'A-hand thumb sweeps

        forward from cheek in

        an
        arc motion'
      imageTexture: {fileID: 2800000, guid: 8732f2a079c498b4c96e0d99a76470db, type: 3}
    sign3:
      title: 3. GOOD
      description: 'Flat fingertips from

        lips place down into

        open
        palm'
      imageTexture: {fileID: 2800000, guid: 68c14a67fa11ed24ab2c8294c432ab53, type: 3}
  currentLessonIndex: 1
  isLessonActive: 0
